# Zabezpečení
.env
.env.*
# Keep the worker env template tracked (it holds only placeholders, no secrets).
!.env.worker.example
# Ignore nested + generated/resolved Netlify configs (e.g. apps/edge/netlify.toml,
# .netlify/netlify.toml, apps/edge/.netlify/...), but keep the ROOT netlify.toml
# tracked so Git-based Netlify deploys get the repo-relative paths.
netlify.toml
!/netlify.toml
.netlify/

# Node a závislosti
node_modules/
package-lock.json

# Logy a OS
npm-debug.log*
.DS_Store
Thumbs.db

# Worker
.env.worker
.paperbot-worker-state.json
.paperbot-worker-state*.json
.paperbot-live-spot-preflight.json
logs/local-binance-worker.log
logs/local-binance-worker.err.log